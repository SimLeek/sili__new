Checks: >
  bugprone-*, clang-analyzer-*, concurrency-*, performance-*,
  readability-*, cppcoreguidelines-*, misc-*, modernize-*,
  portability-*, cert-*,
  -modernize-use-trailing-return-type,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers
# Not WarningsAsErrors='*' on purpose: the legacy header will generate
# thousands of findings on day one. Gate on "no new violations" instead
# (run clang-tidy only on changed files, or reviewdog-filter the output).
WarningsAsErrors: ''
HeaderFilterRegex: '.*'
FormatStyle: none
CheckOptions:
  - key: readability-function-size.LineThreshold
    value: 300
  - key: readability-function-size.StatementThreshold
    value: 300
  - key: readability-function-size.NestingLevelThreshold
    value: 6
